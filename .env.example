# Copy to .env for local development. Do not commit credentials.
DATABASE_URL=sqlite://./server/data/polls.sqlite?mode=rwc
API_BIND=127.0.0.1:8080
# Public origin of the site. Must be the https domain in production.
PUBLIC_BASE_URL=http://127.0.0.1:3000
API_PUBLIC_URL=http://localhost:8080
API_SERVER_BASE=http://127.0.0.1:8080/api
# Only used by the docker compose `tls` profile (Caddy automatic HTTPS).
POLL_DOMAIN=
PAYSTACK_API_BASE=https://api.paystack.co
PAYSTACK_SECRET_KEY=
PAYSTACK_FEE_PASS_THROUGH_CONFIRMED=false
PAID_POLLING_ENABLED=false
# Test-key rehearsal only. Requires PAYSTACK_SECRET_KEY to start with sk_test_.
# It bypasses roster and schedule gates so the full payment -> ballot -> receipt
# loop can be exercised. It never works with an sk_live_ key.
DEMO_MODE=false
LEGAL_REVIEW_APPROVED=false
PAYSTACK_LIVE_APPROVED=false
ROSTER_VERIFICATION_APPROVED=false
PAYMENT_REFUND_REHEARSALS_COMPLETE=false
PRODUCTION_DOMAIN_CONFIGURED=false
BACKUPS_AND_RESTORE_VERIFIED=false
REFUND_RESERVE_READY=false
ADMIN_CONTROLS_VERIFIED=false
PAYSTACK_SYNTHETIC_EMAIL_DOMAIN=receipts.invalid
DEVICE_FINGERPRINT_HMAC_KEY=
CARD_FINGERPRINT_HMAC_KEY=
# Argon2 PHC string. Generate it with:
#   printf 'your-strong-password' | cargo run --manifest-path server/Cargo.toml -- --hash-password
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_HMAC_KEY=
ADMIN_USERNAME=admin
# true in production so the admin session cookie is HTTPS-only.
COOKIE_SECURE=false

