# Normalize line endings so Linux hosts and containers get LF.
* text=auto

*.sh text eol=lf
*.service text eol=lf
*.sql text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
Dockerfile text eol=lf
Caddyfile text eol=lf
*.json text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.css text eol=lf
*.rs text eol=lf
*.md text eol=lf
